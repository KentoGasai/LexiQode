# Third-party reverse-engineering tool, kept locally and never committed.
rea-rea-agents-6.5.0/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
report.txt

# Node / extension
node_modules/
extension/out/
extension/*.vsix
.turbo/
*.tsbuildinfo

# The app's vendored browser bundles. They are copied out of node_modules by
# `npm run vendor`, so the repository keeps the version list and not the bytes.
app/vendor/

# Local runtime state. Settings, sessions and the runtime descriptor live in the
# user profile, never in the repository; project rules are the exception and do
# belong in version control.
*.log
*.sqlite
*.db

# Editors
.idea/
.vs/

# OS
Thumbs.db
desktop.ini
.DS_Store